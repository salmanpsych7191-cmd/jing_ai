{
  "name": "jing-node-agent",
  "version": "1.0.0",
  "description": "JING restaurant AI agent (WhatsApp + voice + booking system) - TypeScript/Node/Express port",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server/index.ts",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "test": "node --test dist/tests/"
  },
  "nodemonConfig": {
    "watch": ["src"],
    "ext": "ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "groq-sdk": "^0.7.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "openai": "^4.56.0",
    "pg": "^8.12.0",
    "twilio": "^5.3.1",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
